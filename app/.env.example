# Solana RPC. The public endpoint is heavily rate limited -- get a free Helius key.
# https://dashboard.helius.dev
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Magic Eden. Read endpoints (stats, listings) work WITHOUT a key.
# A key is only needed for /v2/instructions/* -- the endpoints that build a
# buy transaction. Without it, buying returns HTTP 401. See ../README.md
ME_API_KEY=

# ---- RPC providers, tried in this order ----
# Alchemy first: 30M compute units/mo free tier, and its DAS API (Beta) covers
# compressed NFTs. https://dashboard.alchemy.com
ALCHEMY_RPC_URL=

# Helius as fallback. Smaller free tier but DAS is GA rather than Beta, so it is
# the safer of the two for compressed-NFT reads.
HELIUS_RPC_URL=

# ---- Market data sources ----
# Tensor access is an application form for traders/market-makers, not self-serve.
# Leave blank until approved; the registry reports it as "gated".
TENSOR_API_KEY=

# SimpleHash is NOT configurable: acquired by Phantom Feb 2025, API sunset
# 27 Mar 2025. See INDEXER.md.
